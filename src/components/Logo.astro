---
// Franz Mozar logo: lowercase "franzmozar" wordmark in heavy Archivo ending in
// a glowing mint full stop. The compact form is a drawn "fm." icon tile.
import { site } from '../data/site';

interface Props {
  /** Show the drawn "fm." icon instead of the wordmark. */
  icon?: boolean;
  size?: number;
}

const { icon = false, size = 30 } = Astro.props;
const word = site.name.toLowerCase().replace(/\s+/g, '');
---

{
  icon ? (
    <svg class="icon" viewBox="0 0 48 48" width={size} height={size} fill="none" aria-hidden="true">
      <rect class="tile" x="0.75" y="0.75" width="46.5" height="46.5" rx="11" />
      <g transform="translate(0 4) scale(0.82)">
        <path class="ink" d="M11 37V17.5c0-3.6 2.4-6 6-6h3.5M6.5 20h11" />
        <path class="ink" d="M22 37V20M22 27c0-4.2 2.2-7 5.25-7s5.25 2.8 5.25 7v10M32.5 27c0-4.2 2.2-7 5.25-7S43 22.8 43 27v10" />
      </g>
      <circle class="dot" cx="42.2" cy="32.6" r="2.6" />
    </svg>
  ) : (
    <span class="word">
      {word}
      <span class="stop" aria-hidden="true">.</span>
    </span>
  )
}

<style>
  .word {
    display: inline-flex;
    align-items: baseline;
    font-weight: 800;
    font-stretch: 108%;
    letter-spacing: -0.045em;
    font-size: 1.3rem;
    line-height: 1;
    color: var(--text);
  }

  .stop {
    color: var(--accent);
    text-shadow: 0 0 12px rgba(61, 220, 151, 0.7);
    margin-left: 0.02em;
    transition: text-shadow 300ms var(--ease-out);
  }

  :global(a:hover) > .word .stop {
    text-shadow: 0 0 18px rgba(61, 220, 151, 1);
  }

  .icon {
    flex: none;
  }

  .tile {
    fill: var(--bg);
    stroke: var(--line-strong);
    stroke-width: 1.5;
  }

  .dot {
    fill: var(--accent);
  }

  .ink {
    stroke: var(--text);
    stroke-width: 5;
    stroke-linecap: butt;
    stroke-linejoin: round;
  }
</style>
