---
import type { Listing } from '../data/listings';

interface Props {
  listing: Listing;
}

// Fictional homepage drawn in the listing's swatch. Stands in for a real
// screenshot until the client site is added; never a real business.
const { listing } = Astro.props;
const store = listing.platform === 'Shopify';
const art = listing.previewArt ?? 'goods';

const below: Record<typeof art, string[]> = {
  goods: ['Tote bag', 'Water bottle', 'Planter'],
  calendar: ['Our services', 'Prices', 'Find us'],
  fashion: ['Jackets', 'Knitwear', 'Accessories'],
  dining: ['Menu', "What's on", 'Book a table'],
  practice: ['How we help', 'Our team', 'Contact'],
};
---

<div class:list={['preview', store ? 'store' : 'site']} aria-hidden="true">
  <div class="bar"><span></span><span></span><span></span><em>sample-{store ? 'store' : 'site'}.com</em></div>
  <div class="nav">
    <strong>{store ? 'Sample Store' : 'Sample Co.'}</strong>
    <span>{store ? 'Shop' : 'About'}</span><span>{store ? 'New in' : 'Services'}</span><span>{store ? 'Cart (2)' : 'Contact'}</span>
  </div>
  <div class="hero">
    <div class="hero-copy">
      <p class="hl">{listing.previewHeadline ?? listing.name}</p>
      <p class="btn">{store ? 'Shop now' : 'Get in touch'}</p>
    </div>
    <svg class="art" viewBox="0 0 120 80" preserveAspectRatio="xMidYMid slice">
      <rect width="120" height="80" fill="var(--a)" opacity=".2" />
      {
        art === 'goods' && (
          <g>
            <circle cx="88" cy="30" r="18" fill="var(--a)" opacity=".55" />
            <path d="M40 74 46 34h28l6 40Z" fill="var(--i)" />
            <rect x="50" y="22" width="20" height="14" rx="2" fill="var(--a)" />
            <path d="M84 74c0-14 6-22 12-22s12 8 12 22Z" fill="var(--a)" />
          </g>
        )
      }
      {
        art === 'calendar' && (
          <g>
            <rect x="22" y="14" width="76" height="58" rx="4" fill="var(--g)" />
            <rect x="22" y="14" width="76" height="14" rx="4" fill="var(--a)" />
            <rect x="34" y="8" width="5" height="12" rx="2" fill="var(--i)" />
            <rect x="81" y="8" width="5" height="12" rx="2" fill="var(--i)" />
            {[0, 1, 2, 3, 4].map((c) =>
              [0, 1, 2].map((r) => (
                <rect
                  x={28 + c * 13.5}
                  y={34 + r * 12}
                  width="10"
                  height="8"
                  rx="1.5"
                  fill={c === 3 && r === 1 ? 'var(--a)' : 'var(--i)'}
                  opacity={c === 3 && r === 1 ? 1 : 0.18}
                />
              )),
            )}
          </g>
        )
      }
      {
        art === 'fashion' && (
          <g>
            <path d="M60 10v6" stroke="var(--i)" stroke-width="2" />
            <path d="M60 16 30 32h60Z" fill="none" stroke="var(--i)" stroke-width="2.5" stroke-linejoin="round" />
            <path d="M40 32h40l6 46H34Z" fill="var(--a)" />
            <path d="M52 32h16l-8 18Z" fill="var(--g)" opacity=".85" />
          </g>
        )
      }
      {
        art === 'dining' && (
          <g>
            <ellipse cx="60" cy="46" rx="30" ry="22" fill="var(--g)" />
            <ellipse cx="60" cy="46" rx="20" ry="14" fill="var(--a)" />
            <rect x="18" y="22" width="4" height="46" rx="2" fill="var(--i)" />
            <path d="M14 22v12a6 6 0 0 0 12 0V22" fill="none" stroke="var(--i)" stroke-width="2.5" />
            <path d="M98 22c6 0 8 8 8 18h-8Z" fill="var(--i)" />
            <rect x="98" y="38" width="4" height="30" rx="2" fill="var(--i)" />
          </g>
        )
      }
      {
        art === 'practice' && (
          <g>
            <path d="M24 30 60 12l36 18Z" fill="var(--i)" />
            {[0, 1, 2, 3].map((n) => (
              <rect x={32 + n * 16} y="34" width="8" height="30" fill="var(--a)" />
            ))}
            <rect x="24" y="64" width="72" height="6" fill="var(--i)" />
          </g>
        )
      }
    </svg>
  </div>
  {
    store ? (
      <div class="tiles">
        {below[art].map((label, n) => (
          <div class="tile">
            <svg viewBox="0 0 40 40">
              {n === 0 && <path d="M12 34 14 14h12l2 20Z" fill="var(--a)" />}
              {n === 1 && <path d="M15 34V16l5-6 5 6v18Z" fill="var(--i)" opacity=".8" />}
              {n === 2 && <circle cx="20" cy="22" r="11" fill="var(--a)" opacity=".75" />}
            </svg>
            <p>{label}</p>
          </div>
        ))}
      </div>
    ) : (
      <div class="cols">
        {below[art].map((label) => (
          <p>
            <b>{label}</b>
            <span>Find out more</span>
          </p>
        ))}
      </div>
    )
  }
</div>

<style>
  /* Every size is in cqw so the preview scales like a screenshot: same
     layout at any frame width. Designed to fit a 16:10 frame. */
  .preview {
    position: absolute;
    inset: 0;
    background: var(--g);
    color: var(--i);
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr) auto;
    font-family: var(--font);
    font-stretch: 100%;
    container-type: inline-size;
    overflow: hidden;
    line-height: 1.2;
  }

  .bar {
    height: 4.6cqw;
    display: flex;
    align-items: center;
    gap: 0.9cqw;
    padding-inline: 1.8cqw;
    background: color-mix(in srgb, var(--i) 10%, var(--g));
  }

  .bar span {
    width: 1.2cqw;
    height: 1.2cqw;
    border-radius: 50%;
    background: color-mix(in srgb, var(--i) 28%, var(--g));
  }

  .bar em {
    font-style: normal;
    font-size: 1.6cqw;
    white-space: nowrap;
    margin-left: 1.6cqw;
    padding: 0.2cqw 1.4cqw;
    border-radius: 0.6cqw;
    background: color-mix(in srgb, var(--g) 70%, white);
    color: color-mix(in srgb, var(--i) 60%, var(--g));
  }

  .nav {
    height: 8cqw;
    display: flex;
    align-items: center;
    gap: 3.5cqw;
    padding-inline: 5cqw;
    font-size: 2cqw;
    font-weight: 600;
    white-space: nowrap;
  }

  .nav strong {
    margin-right: auto;
    font-weight: 900;
    font-stretch: 112%;
    font-size: 2.6cqw;
    letter-spacing: -0.02em;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 4cqw;
    padding: 1cqw 5cqw 0;
    align-items: center;
    min-height: 0;
  }

  .hl {
    font-size: 4cqw;
    font-weight: 800;
    font-stretch: 108%;
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .btn {
    margin-top: 2.6cqw;
    display: inline-block;
    font-size: 1.8cqw;
    font-weight: 700;
    padding: 0.9cqw 1.8cqw;
    border-radius: 0.6cqw;
    background: var(--a);
    color: var(--g);
  }

  .art {
    width: 100%;
    height: 100%;
    max-height: 26cqw;
    border-radius: 0.8cqw;
    display: block;
  }

  .tiles,
  .cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3cqw;
    padding: 2.4cqw 5cqw 3.4cqw;
    font-size: 1.9cqw;
  }

  .tile svg {
    width: 100%;
    height: 7cqw;
    display: block;
    background: color-mix(in srgb, var(--i) 7%, var(--g));
    border-radius: 0.5cqw;
  }

  .tile p {
    margin-top: 1cqw;
    font-weight: 700;
    white-space: nowrap;
  }

  .cols p {
    display: grid;
    gap: 0.4cqw;
    padding-top: 1.2cqw;
    border-top: 0.4cqw solid var(--a);
  }

  .cols b {
    font-weight: 800;
    font-stretch: 108%;
    white-space: nowrap;
  }

  .cols span {
    color: color-mix(in srgb, var(--i) 65%, var(--g));
  }
</style>