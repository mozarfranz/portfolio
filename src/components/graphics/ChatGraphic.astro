---
// FAQ graphic: a question comes in, a typing indicator plays, and the answer
// lines write themselves out. Loops every 8s. Fills its column.
---

<svg class="chat" viewBox="0 0 560 220" fill="none" aria-hidden="true">
  <!-- incoming question -->
  <g class="msg q">
    <circle class="avatar" cx="20" cy="44" r="14" />
    <path class="avatar-icon" d="M13 51c1.2-3.4 4-5.2 7-5.2s5.8 1.8 7 5.2M20 43.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />
    <rect class="bubble-q" x="46" y="20" width="320" height="56" rx="12" />
    <path class="bubble-q" d="M52 68l-8 14 20-8" />
    <rect class="line" x="64" y="38" width="230" height="7" rx="3.5" />
    <rect class="line" x="64" y="52" width="150" height="7" rx="3.5" />
  </g>

  <!-- typing indicator -->
  <g class="typing">
    <rect class="bubble-t" x="470" y="104" width="72" height="32" rx="16" />
    <circle class="tdot d1" cx="490" cy="120" r="3.5" />
    <circle class="tdot d2" cx="506" cy="120" r="3.5" />
    <circle class="tdot d3" cx="522" cy="120" r="3.5" />
  </g>

  <!-- answer -->
  <g class="msg a">
    <rect class="bubble-a" x="150" y="100" width="392" height="96" rx="12" />
    <rect class="aline l1" x="170" y="118" width="300" height="7" rx="3.5" />
    <rect class="aline l2" x="170" y="134" width="340" height="7" rx="3.5" />
    <rect class="aline l3" x="170" y="150" width="250" height="7" rx="3.5" />
    <rect class="aline l4" x="170" y="166" width="140" height="7" rx="3.5" />
    <circle class="seen" cx="542" cy="200" r="11" />
    <path class="seen-check" d="M537 200.5l3.5 3.5 6.5-7" />
  </g>
</svg>

<style>
  .chat {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 2rem;
  }

  .avatar {
    fill: var(--bg-panel);
    stroke: var(--line-strong);
  }

  .avatar-icon {
    stroke: var(--text-faint);
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  .bubble-q {
    fill: var(--bg-panel);
    stroke: var(--line-strong);
  }

  .line {
    fill: var(--line-strong);
  }

  .bubble-t {
    fill: rgba(61, 220, 151, 0.08);
    stroke: rgba(61, 220, 151, 0.45);
  }

  .tdot {
    fill: var(--accent);
    animation: typing-dot 1s ease-in-out infinite;
  }

  .d2 {
    animation-delay: 0.15s;
  }

  .d3 {
    animation-delay: 0.3s;
  }

  @keyframes typing-dot {
    0%,
    60%,
    100% {
      translate: 0 0;
      opacity: 0.5;
    }
    30% {
      translate: 0 -4px;
      opacity: 1;
    }
  }

  .bubble-a {
    fill: rgba(61, 220, 151, 0.07);
    stroke: rgba(61, 220, 151, 0.5);
  }

  .aline {
    fill: rgba(236, 238, 241, 0.75);
    transform-box: fill-box;
    transform-origin: left center;
    animation: write 8s var(--ease-out) infinite;
  }

  .l2 {
    animation-delay: 0.25s;
  }

  .l3 {
    animation-delay: 0.5s;
  }

  .l4 {
    animation-delay: 0.75s;
  }

  @keyframes write {
    0%,
    48% {
      scale: 0 1;
    }
    58%,
    100% {
      scale: 1 1;
    }
  }

  .seen {
    fill: var(--accent);
  }

  .seen-check {
    stroke: var(--accent-ink);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .q {
    animation: q 8s var(--ease-out) infinite;
  }

  .typing {
    animation: typing 8s var(--ease-out) infinite;
  }

  .a {
    animation: a 8s var(--ease-out) infinite;
  }

  @keyframes q {
    0% {
      opacity: 0;
      translate: 0 10px;
    }
    8%,
    90% {
      opacity: 1;
      translate: 0 0;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes typing {
    0%,
    14% {
      opacity: 0;
    }
    18%,
    40% {
      opacity: 1;
    }
    44%,
    100% {
      opacity: 0;
    }
  }

  @keyframes a {
    0%,
    42% {
      opacity: 0;
      translate: 0 10px;
    }
    48%,
    90% {
      opacity: 1;
      translate: 0 0;
    }
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .q,
    .a,
    .typing,
    .tdot,
    .aline {
      animation: none;
    }

    .typing {
      opacity: 0;
    }
  }

  @media (max-width: 960px) {
    .chat {
      display: none;
    }
  }
</style>
