---
// Shopify panel graphic: a product drops along a dashed path into the cart,
// the cart count ticks up, and checkout completes with a drawn check.
// Loops every 7s. Fills its column.
---

<svg class="checkout" viewBox="0 0 480 170" fill="none" aria-hidden="true">
  <rect class="frame" x="0.5" y="0.5" width="479" height="169" rx="8" />

  <!-- product card -->
  <g class="product">
    <rect class="card" x="18" y="22" width="128" height="126" rx="6" />
    <rect class="photo" x="28" y="32" width="108" height="66" rx="4" />
    <path class="bag-art" d="M69 88V60h26v28zM75 60v-5a7 7 0 0 1 14 0v5" />
    <rect class="text" x="28" y="108" width="72" height="6" rx="3" />
    <rect class="price" x="28" y="122" width="36" height="9" rx="2" />
    <rect class="add-btn" x="102" y="120" width="34" height="13" rx="3" />
  </g>

  <!-- path into the cart -->
  <path class="route" d="M146 86c56 0 66 -30 118 -30" />
  <circle class="parcel" r="5" />

  <!-- cart -->
  <g class="cart">
    <rect class="card" x="268" y="26" width="78" height="60" rx="6" />
    <path class="cart-icon" d="M287 44h4l4 19h22l4-14h-27" />
    <circle class="cart-icon-fill" cx="298" cy="70" r="2.4" />
    <circle class="cart-icon-fill" cx="313" cy="70" r="2.4" />
    <circle class="badge" cx="340" cy="30" r="9" />
    <text class="count c1" x="340" y="34">1</text>
    <text class="count c2" x="340" y="34">2</text>
  </g>

  <!-- checkout button and confirmation -->
  <rect class="pay" x="268" y="100" width="196" height="26" rx="5" />
  <rect class="pay-text" x="282" y="110" width="64" height="6" rx="3" />
  <rect class="text" x="268" y="138" width="110" height="6" rx="3" />
  <g class="done">
    <circle class="done-ring" cx="420" cy="56" r="22" />
    <path class="done-check" d="M410 56.5l7 7 13.5-15" />
  </g>
</svg>

<style>
  .checkout {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 1.75rem;
  }

  .frame {
    stroke: var(--line-strong);
    fill: rgba(10, 11, 13, 0.6);
  }

  .card {
    fill: var(--bg-panel);
    stroke: var(--line);
  }

  .photo {
    fill: rgba(61, 220, 151, 0.12);
  }

  .bag-art {
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  .text {
    fill: var(--line-strong);
  }

  .price {
    fill: var(--text-faint);
  }

  .add-btn {
    fill: rgba(61, 220, 151, 0.25);
    stroke: rgba(61, 220, 151, 0.6);
  }

  .route {
    stroke: var(--line-strong);
    stroke-width: 1.25;
    stroke-dasharray: 3 4;
  }

  .parcel {
    fill: var(--accent);
    offset-path: path('M146 86c56 0 66 -30 118 -30');
    offset-rotate: 0deg;
    filter: drop-shadow(0 0 4px rgba(61, 220, 151, 0.9));
    animation: parcel 7s var(--ease-out) infinite;
  }

  @keyframes parcel {
    0%,
    6% {
      offset-distance: 0%;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    30% {
      offset-distance: 100%;
      opacity: 1;
    }
    33%,
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }

  .cart-icon {
    stroke: var(--text);
    stroke-width: 1.6;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .cart-icon-fill {
    fill: var(--text);
  }

  .cart {
    transform-box: view-box;
    transform-origin: 307px 56px;
    animation: bump 7s var(--ease-out) infinite;
  }

  @keyframes bump {
    0%,
    30%,
    100% {
      scale: 1;
    }
    34% {
      scale: 1.07;
    }
    40% {
      scale: 1;
    }
  }

  .badge {
    fill: var(--accent);
  }

  .count {
    fill: var(--accent-ink);
    font-size: 11px;
    font-weight: 800;
    text-anchor: middle;
    font-family: var(--font);
  }

  .c1 {
    animation: count-old 7s step-end infinite;
  }

  .c2 {
    animation: count-new 7s step-end infinite;
  }

  @keyframes count-old {
    0%,
    100% {
      opacity: 1;
    }
    32% {
      opacity: 0;
    }
  }

  @keyframes count-new {
    0%,
    100% {
      opacity: 0;
    }
    32% {
      opacity: 1;
    }
  }

  .pay {
    fill: var(--accent);
    animation: press 7s var(--ease-out) infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .pay-text {
    fill: var(--accent-ink);
  }

  @keyframes press {
    0%,
    48%,
    100% {
      scale: 1;
    }
    52% {
      scale: 0.97;
    }
    56% {
      scale: 1;
    }
  }

  .done-ring {
    fill: rgba(61, 220, 151, 0.1);
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  .done-check {
    stroke: var(--accent);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 32;
    stroke-dashoffset: 32;
    animation: check 7s var(--ease-out) infinite;
  }

  .done {
    animation: done 7s var(--ease-out) infinite;
  }

  @keyframes check {
    0%,
    56% {
      stroke-dashoffset: 32;
    }
    66%,
    100% {
      stroke-dashoffset: 0;
    }
  }

  @keyframes done {
    0%,
    54% {
      opacity: 0;
    }
    58%,
    92% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .parcel,
    .cart,
    .c1,
    .c2,
    .pay,
    .done,
    .done-check {
      animation: none;
    }

    .parcel,
    .c1 {
      opacity: 0;
    }

    .c2,
    .done {
      opacity: 1;
    }

    .done-check {
      stroke-dashoffset: 0;
    }
  }
</style>
